# Yüklenen dosyalar yalnızca statik içerik olarak sunulur.
# Bu dosya, PHP çalıştırma engelini Apache tabanlı manuel kurulumlarda da sağlar.
Options -Indexes -ExecCGI

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .sh
    RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .sh
</IfModule>

SetHandler none

<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>
